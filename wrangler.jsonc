// Exxel Estate Worker on the owner's own Cloudflare account.
// Secrets (DATABASE_URL, R2_*, GEMINI_API_KEY, ...) are set with
// `npx wrangler secret put NAME`, never in this file. See docs/cloudflare-deploy.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exxel-estate",
  "main": "./build/sites-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // Public base URL for canonical links, hreflang and the sitemap.
  // No schedules on Cloudflare since 2026-11-23: the live site is the Mittwald container, whose cronjobs call
  // /api/cron/health and /api/cron/daily (docs/mittwald-migration.md). Two schedulers would send digests twice.
  "triggers": { "crons": [] },
  "vars": { "SITE_URL": "https://exxel-estate.estatemarket24.workers.dev", "CONTACT_EMAIL": "info@estatemarket24.com", "EMAIL_FROM": "EstateMarket24 <onboarding@resend.dev>" },
  // No longer used by the live site: counters, translation cache and assistant quotas moved to the
  // main database (DATABASE_URL). Kept only as the local-development fallback when DATABASE_URL is
  // unset; drizzle/ stays as its history. See docs/mittwald-migration.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exxel-estate-db",
      "database_id": "60ca008b-3c3c-41cd-944c-027e67f7a1b1",
      "migrations_dir": "drizzle"
    }
  ],
  // Private files: office documents, tour captures and legacy images.
  // Public listing photos stay in the EU bucket reached through R2_* secrets.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "exxel-estate-private",
      "jurisdiction": "eu"
    }
  ]
}
