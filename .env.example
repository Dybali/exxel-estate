# Site runtime: configure with the native hosting environment tool, not this file.
# Random shared secret >=32 chars, also set on the panorama worker.
CAPTURE_WORKER_TOKEN=
# pilot for a local development computer; cloud only after permanent deployment.
CAPTURE_WORKER_MODE=pilot

# Worker runtime only. Root Site origin, HTTPS required.
CAPTURE_SITE_URL=https://exxel-estate.blue-grape-8839.chatgpt.site
# HUGIN_BIN=/usr/bin

# Server-only Gemini property assistant. Never prefix the key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Conservative maximum model-call reservations each day (two per chat turn).
AI_DAILY_CALL_LIMIT=400

# E-mail verification / password-reset codes (docs/auth.md): HMAC key, 32+ random characters.
# Optional: without it a key derived from DATABASE_URL is used. Never commit real values.
EMAIL_CODE_SECRET=
